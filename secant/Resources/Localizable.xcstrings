        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu identidad de mensajería y todo el historial de chats de este dispositivo. Tus fondos no se ven afectados y puedes recuperarlos en cualquier momento con tu frase semilla."
          }
        }
      }
